#!/bin/bash
# =============================================================================
# HP-nodes bootstrap user-data
# =============================================================================
# Runs on first boot. Adds a secondary ENI from the AZ-matching TMM subnet so
# TMM data-plane traffic stays on a dedicated interface that AWS VPC CNI
# ignores (node.k8s.amazonaws.com/no_manage=true).
#
# This script must run BEFORE the EKS bootstrap script (which the parent MIME
# multipart includes). The interface needs to exist when the kubelet starts so
# Multus + the NetworkAttachmentDefinition (master: ens${secondary_eni_device_index + 5})
# bind correctly.
# =============================================================================

set -euo pipefail
exec > >(tee -a /var/log/hp-nodes-bootstrap.log) 2>&1
echo "[hp-nodes] bootstrap started at $(date -u +%FT%TZ)"

# IMDSv2 token (matches the IMDSv2-required launch template config).
TOKEN=$(curl -sS -X PUT \
  -H "X-aws-ec2-metadata-token-ttl-seconds: 21600" \
  http://169.254.169.254/latest/api/token)

IMDS() {
  curl -sS -H "X-aws-ec2-metadata-token: $TOKEN" \
    "http://169.254.169.254/latest/meta-data/$1"
}

AZ=$(IMDS placement/availability-zone)
INSTANCE_ID=$(IMDS instance-id)
REGION=$(IMDS placement/region)

echo "[hp-nodes] instance=$INSTANCE_ID az=$AZ region=$REGION"

# AZ → TMM subnet mapping is rendered by Terraform from the
# tmm_subnet_id_by_az local. Format: one bash case branch per AZ.
declare -A TMM_SUBNET_BY_AZ
%{ for az, subnet_id in tmm_subnet_by_az ~}
TMM_SUBNET_BY_AZ["${az}"]="${subnet_id}"
%{ endfor ~}

TMM_SUBNET="$${TMM_SUBNET_BY_AZ[$AZ]:-}"
if [[ -z "$TMM_SUBNET" ]]; then
  echo "[hp-nodes] FATAL: no TMM subnet defined for AZ $AZ"
  exit 1
fi
echo "[hp-nodes] tmm_subnet=$TMM_SUBNET device_index=${secondary_eni_device_index}"

# Create the ENI in the TMM subnet, tagged so VPC CNI ignores it.
ADDITIONAL_IPS_FLAG=""
%{ if additional_ips_per_eni > 0 ~}
ADDITIONAL_IPS_FLAG="--secondary-private-ip-address-count ${additional_ips_per_eni}"
%{ endif ~}

ENI_ID=$(aws ec2 create-network-interface \
  --region "$REGION" \
  --subnet-id "$TMM_SUBNET" \
  --description "tmm-eni-$INSTANCE_ID" \
  --tag-specifications "ResourceType=network-interface,Tags=[\
{Key=node.k8s.amazonaws.com/no_manage,Value=true},\
{Key=bnk-forge:module,Value=eks-cluster-hp-nodes},\
{Key=bnk-forge:cluster,Value=${eks_cluster_name}},\
{Key=Name,Value=tmm-eni-$INSTANCE_ID}]" \
  $ADDITIONAL_IPS_FLAG \
  --query 'NetworkInterface.NetworkInterfaceId' \
  --output text)

echo "[hp-nodes] created eni=$ENI_ID"

# Attach with auto-delete-on-instance-terminate so the ENI doesn't leak when
# the ASG cycles the instance.
ATTACHMENT_ID=$(aws ec2 attach-network-interface \
  --region "$REGION" \
  --network-interface-id "$ENI_ID" \
  --instance-id "$INSTANCE_ID" \
  --device-index ${secondary_eni_device_index} \
  --query 'AttachmentId' \
  --output text)

aws ec2 modify-network-interface-attribute \
  --region "$REGION" \
  --network-interface-id "$ENI_ID" \
  --attachment "AttachmentId=$ATTACHMENT_ID,DeleteOnTermination=true"

echo "[hp-nodes] attached eni=$ENI_ID device_index=${secondary_eni_device_index} attachment=$ATTACHMENT_ID (delete-on-termination=true)"

# Wait for the kernel to register the interface — gives the kubelet a clean
# device list when it starts. AL2023 names it predictably by device index:
# device_index=0 → ens5, 1 → ens6, 2 → ens7, ...
EXPECTED_IF="ens$((${secondary_eni_device_index} + 5))"
for _ in $(seq 1 30); do
  if ip link show "$EXPECTED_IF" >/dev/null 2>&1; then
    echo "[hp-nodes] kernel registered $EXPECTED_IF"
    break
  fi
  sleep 1
done

echo "[hp-nodes] bootstrap completed at $(date -u +%FT%TZ)"
