#!/bin/bash
# =============================================================================
# HP-nodes dual-ENI bootstrap
# =============================================================================
# Attaches TWO secondary ENIs at first boot — the EXTERNAL (client-facing) ENI
# from the AZ-matching TMM-external subnet at device-index 3 (→ ens8 on AL2023),
# and the INTERNAL (backend) ENI from the TMM-internal subnet at device-index 2
# (→ ens7). This matches awsbnkctl phase17 (ext=ens8/idx3, int=ens7/idx2). Each
# ENI carries node.k8s.amazonaws.com/no_manage=true (VPC CNI ignores it) PLUS
# f5-cne-device=<ifname> — the tag the BNK cne-controller discovers the host
# device by (CLOUD_HOST_DEVICE_TAG). The host-device NADs claim these real ENIs
# into the TMM pod netns by PCI bus id.
#
# This runs BEFORE EKS's bootstrap (the parent MIME multipart includes
# EKS's own boot.sh as a separate part that fires after this script). The
# interfaces need to exist when the kubelet starts so Multus + NADs bind
# correctly.
# =============================================================================

set -euo pipefail
exec > >(tee -a /var/log/hp-nodes-bootstrap.log) 2>&1
echo "[hp-nodes] bootstrap started at $(date -u +%FT%TZ)"

# IMDSv2 token (matches the IMDSv2-required launch template config).
TOKEN=$(curl -sS -X PUT \
  -H "X-aws-ec2-metadata-token-ttl-seconds: 21600" \
  http://169.254.169.254/latest/api/token)

IMDS() {
  curl -sS -H "X-aws-ec2-metadata-token: $TOKEN" \
    "http://169.254.169.254/latest/meta-data/$1"
}

AZ=$(IMDS placement/availability-zone)
INSTANCE_ID=$(IMDS instance-id)
REGION=$(IMDS placement/region)

echo "[hp-nodes] instance=$INSTANCE_ID az=$AZ region=$REGION"

# AZ → subnet maps rendered by Terraform from the tmm_*_subnet_by_az locals.
declare -A TMM_EXTERNAL_SUBNET_BY_AZ
%{ for az, subnet_id in tmm_external_subnet_by_az ~}
TMM_EXTERNAL_SUBNET_BY_AZ["${az}"]="${subnet_id}"
%{ endfor ~}

declare -A TMM_INTERNAL_SUBNET_BY_AZ
%{ for az, subnet_id in tmm_internal_subnet_by_az ~}
TMM_INTERNAL_SUBNET_BY_AZ["${az}"]="${subnet_id}"
%{ endfor ~}

TMM_EXTERNAL_SUBNET="$${TMM_EXTERNAL_SUBNET_BY_AZ[$AZ]:-}"
TMM_INTERNAL_SUBNET="$${TMM_INTERNAL_SUBNET_BY_AZ[$AZ]:-}"

if [[ -z "$TMM_EXTERNAL_SUBNET" ]]; then
  echo "[hp-nodes] FATAL: no TMM-external subnet defined for AZ $AZ"
  exit 1
fi
if [[ -z "$TMM_INTERNAL_SUBNET" ]]; then
  echo "[hp-nodes] FATAL: no TMM-internal subnet defined for AZ $AZ"
  exit 1
fi

echo "[hp-nodes] tmm_external_subnet=$TMM_EXTERNAL_SUBNET device_index=${external_eni_device_index}"
echo "[hp-nodes] tmm_internal_subnet=$TMM_INTERNAL_SUBNET device_index=${internal_eni_device_index}"

# attach_secondary_eni <subnet_id> <device_index> <role>
#   role is "external" | "internal" — used for ENI tags and log lines
attach_secondary_eni() {
  local SUBNET="$1"
  local DEVICE_INDEX="$2"
  local ROLE="$3"

  # AL2023 names the secondary ENI deterministically: device_index N → ens(N+5).
  # The cne-controller discovers the host device by the f5-cne-device tag, so we
  # tag each ENI with the ifname it will surface as (ens8 ext / ens7 int).
  local IFNAME="ens$((DEVICE_INDEX + 5))"

  local ADDITIONAL_IPS_FLAG=""
%{ if additional_ips_per_eni > 0 ~}
  ADDITIONAL_IPS_FLAG="--secondary-private-ip-address-count ${additional_ips_per_eni}"
%{ endif ~}

  local ENI_ID
  ENI_ID=$(aws ec2 create-network-interface \
    --region "$REGION" \
    --subnet-id "$SUBNET" \
    --description "tmm-$${ROLE}-eni-$INSTANCE_ID" \
    --tag-specifications "ResourceType=network-interface,Tags=[\
{Key=node.k8s.amazonaws.com/no_manage,Value=true},\
{Key=f5-cne-device,Value=$${IFNAME}},\
{Key=f5-bnk:tmm-role,Value=$${ROLE}},\
{Key=bnk-forge:module,Value=eks-cluster-hp-nodes},\
{Key=bnk-forge:cluster,Value=${eks_cluster_name}},\
{Key=Name,Value=tmm-$${ROLE}-eni-$INSTANCE_ID}]" \
    $ADDITIONAL_IPS_FLAG \
    --query 'NetworkInterface.NetworkInterfaceId' \
    --output text)

  echo "[hp-nodes] created $${ROLE} eni=$ENI_ID"

  local ATTACHMENT_ID
  ATTACHMENT_ID=$(aws ec2 attach-network-interface \
    --region "$REGION" \
    --network-interface-id "$ENI_ID" \
    --instance-id "$INSTANCE_ID" \
    --device-index "$DEVICE_INDEX" \
    --query 'AttachmentId' \
    --output text)

  aws ec2 modify-network-interface-attribute \
    --region "$REGION" \
    --network-interface-id "$ENI_ID" \
    --attachment "AttachmentId=$ATTACHMENT_ID,DeleteOnTermination=true"

  aws ec2 modify-network-interface-attribute \
    --region "$REGION" \
    --network-interface-id "$ENI_ID" \
    --no-source-dest-check

  echo "[hp-nodes] disabled source/dest check on $${ROLE} eni=$ENI_ID"

  echo "[hp-nodes] attached $${ROLE} eni=$ENI_ID device_index=$DEVICE_INDEX attachment=$ATTACHMENT_ID (delete-on-termination=true)"
}

attach_secondary_eni "$TMM_EXTERNAL_SUBNET" "${external_eni_device_index}" "external"
attach_secondary_eni "$TMM_INTERNAL_SUBNET" "${internal_eni_device_index}" "internal"

# Wait for the kernel to register both interfaces. AL2023 names them
# predictably: device_index N → ens(N+5).
EXPECTED_EXT_IF="ens$((${external_eni_device_index} + 5))"
EXPECTED_INT_IF="ens$((${internal_eni_device_index} + 5))"

for _ in $(seq 1 30); do
  if ip link show "$EXPECTED_EXT_IF" >/dev/null 2>&1 \
     && ip link show "$EXPECTED_INT_IF" >/dev/null 2>&1; then
    echo "[hp-nodes] kernel registered $EXPECTED_EXT_IF + $EXPECTED_INT_IF"
    break
  fi
  sleep 1
done

echo "[hp-nodes] bootstrap completed at $(date -u +%FT%TZ)"
