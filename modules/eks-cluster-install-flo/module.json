{
  "module": {
    "name": "EKS Cluster Install FLO",
    "path": "modules/eks-cluster-install-flo",
    "version": "2.0.0",
    "layer": "application",
    "category": "bnk",
    "description": "Install F5 Lifecycle Operator (FLO) on AWS EKS via Helm. FLO manages the BNK control plane: CWC, DSSM, Observer, OTEL, RabbitMQ, and TMM (via CNEInstance). Includes CPCL key download and license activation. AWS-tuned default for container_platform.",
    "cloud_specific": true,
    "supported_platforms": ["aws_eks"]
  },
  "source": {
    "kind": "official",
    "channel": "release/2.2"
  },
  "execution": {
    "engine": "kubernetes",
    "deploy_models": ["helm", "kubernetes_manifest"]
  },
  "contract": {
    "metadata_version": "module-metadata/v2alpha1"
  },
  "dependencies": {
    "required": [
      {
        "module": "modules/eks-cluster-install-bnk-prereqs",
        "reason": "Needs namespaces, FAR secrets, and FLO version from manifest"
      },
      {
        "module": "modules/eks-cluster-install-cert-issuer",
        "reason": "FLO requires ClusterIssuer for certificate management"
      }
    ],
    "optional": []
  },
  "inputs": {
    "required": [
      {
        "name": "flo_namespace",
        "type": "string",
        "description": "Namespace for FLO deployment (operator namespace). Gold-standard split: f5-cne-core.",
        "source": "module",
        "from_module": "modules/eks-cluster-install-bnk-prereqs",
        "from_output": "operator_namespace",
        "default": "f5-cne-core"
      },
      {
        "name": "flo_version",
        "type": "string",
        "description": "FLO Helm chart version",
        "source": "module",
        "from_module": "modules/eks-cluster-install-bnk-prereqs",
        "from_output": "flo_version"
      },
      {
        "name": "far_secret_name",
        "type": "string",
        "description": "FAR image pull secret name",
        "source": "module",
        "from_module": "modules/eks-cluster-install-bnk-prereqs",
        "from_output": "far_secret_name",
        "default": "far-secret"
      },
      {
        "name": "cluster_issuer_name",
        "type": "string",
        "description": "ClusterIssuer name for certificate management",
        "source": "module",
        "from_module": "modules/eks-cluster-install-cert-issuer",
        "from_output": "cluster_issuer_name",
        "default": "bnk-ca-cluster-issuer"
      },
      {
        "name": "jwt_token",
        "type": "string",
        "description": "JWT token for F5 BNK licensing — bind to a project secret in the deploy form",
        "source": "user",
        "sensitive": true
      }
    ],
    "optional": [
      {
        "name": "cluster_name",
        "type": "string",
        "description": "Name of the Kubernetes cluster",
        "default": "",
        "source": "auto"
      },
      {
        "name": "license_mode",
        "type": "string",
        "description": "License mode: connected or f5licenseproxy",
        "default": "connected",
        "source": "user"
      },
      {
        "name": "cert_manager_ready",
        "type": "boolean",
        "description": "Dependency gate from cert-manager",
        "source": "module",
        "from_module": "modules/eks-cluster-install-cert-manager",
        "from_output": "cert_manager_ready",
        "default": true
      },
      {
        "name": "container_platform",
        "type": "string",
        "description": "Container platform type (Generic, AWS, Azure). AWS-tuned default for this catalog — enables cloud-aware gRPC and networking.",
        "default": "AWS",
        "source": "user"
      }
    ]
  },
  "outputs": {
    "key_outputs": [
      {
        "name": "flo_namespace",
        "type": "string",
        "description": "Namespace where FLO is deployed",
        "used_by": ["modules/eks-cluster-cneinstall"],
        "sensitive": false
      },
      {
        "name": "flo_ready",
        "type": "boolean",
        "description": "Gate output indicating FLO is ready",
        "used_by": ["modules/eks-cluster-cneinstall"],
        "sensitive": false
      },
      {
        "name": "crds_installed",
        "type": "boolean",
        "description": "Gate output indicating CRDs are installed",
        "used_by": ["modules/eks-cluster-cneinstall"],
        "sensitive": false
      }
    ]
  },
  "providers": {
    "required": ["kubernetes", "helm"],
    "optional": ["null", "time", "local"]
  },
  "deployment": {
    "order": 50,
    "estimated_time": "5 minutes",
    "requires_user_input": false,
    "sensitive_inputs": ["jwt_token"]
  }
}
