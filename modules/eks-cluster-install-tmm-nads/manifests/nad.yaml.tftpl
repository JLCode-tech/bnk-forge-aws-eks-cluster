---
apiVersion: k8s.cni.cncf.io/v1
kind: NetworkAttachmentDefinition
metadata:
  name: ${nad_name}
  namespace: ${nad_namespace}
  labels:
    app.kubernetes.io/name: ${nad_name}
    app.kubernetes.io/managed-by: bnk-forge-eks-cluster-install-tmm-nads
    f5-bnk-role: ${tmm_role}
spec:
  config: |
    {
      "cniVersion": "0.3.1",
      "type": "${cni_type}",
      "master": "${master}",
%{ if cni_type == "ipvlan" ~}
      "mode": "${ipvlan_mode}",
%{ endif ~}
      "ipam": {
        "type": "static",
        "addresses": [
          { "address": "${static_address}" }
        ]
      }
    }
