{
  "module": {
    "name": "EKS Cluster Install TMM NADs",
    "path": "modules/eks-cluster-install-tmm-nads",
    "version": "0.3.0-alpha",
    "layer": "application",
    "category": "bnk",
    "description": "Creates the two AWS-specific NetworkAttachmentDefinitions (ens7-ipvlan-l2 external, ens8-ipvlan-l2 internal) TMM uses on its data-plane secondary ENIs, with apply-time tag discovery to derive each NAD's static IPAM placeholder. Multus CNI install itself is handled by the cloud-agnostic eks-cluster-install-multus module (vendored from bnk-forge-catalog-shared) — this module depends on it via multus_ready.",
    "cloud_specific": true,
    "supported_platforms": ["aws_eks"]
  },
  "source": {
    "kind": "official",
    "channel": "release/2.2"
  },
  "execution": {
    "engine": "opentofu",
    "deploy_models": ["kubernetes_manifest"]
  },
  "contract": {
    "metadata_version": "module-metadata/v2alpha1"
  },
  "dependencies": {
    "required": [
      {
        "module": "modules/eks-cluster-install-multus",
        "reason": "Multus must be installed and the NetworkAttachmentDefinition CRD Established before this module applies NAD CRs."
      }
    ],
    "optional": [
      {
        "module": "modules/eks-cluster-hp-nodes",
        "reason": "Logical predecessor — the NADs bind to the ens7/ens8 ENIs hp-nodes attaches AND hp-nodes creates the tagged TMM subnets this module discovers."
      }
    ]
  },
  "inputs": {
    "required": [],
    "optional": [
      {
        "name": "multus_ready",
        "type": "boolean",
        "description": "Gate from install-multus.",
        "default": false,
        "source": "module",
        "from_module": "modules/eks-cluster-install-multus",
        "from_output": "multus_ready"
      },
      {
        "name": "nad_namespace",
        "type": "string",
        "description": "Namespace for the NADs.",
        "default": "default",
        "source": "user"
      },
      {
        "name": "nad_external_name",
        "type": "string",
        "description": "External NAD name.",
        "default": "ens7-ipvlan-l2",
        "source": "user"
      },
      {
        "name": "nad_internal_name",
        "type": "string",
        "description": "Internal NAD name.",
        "default": "ens8-ipvlan-l2",
        "source": "user"
      }
    ]
  },
  "outputs": {
    "key_outputs": [
      {
        "name": "nads_applied",
        "type": "boolean",
        "description": "Gate output: both NADs applied.",
        "used_by": ["modules/eks-cluster-cneinstall"],
        "sensitive": false
      },
      {
        "name": "nad_external_name",
        "type": "string",
        "description": "Final external NAD name (echoed back).",
        "used_by": ["modules/eks-cluster-cneinstall"],
        "sensitive": false
      },
      {
        "name": "nad_internal_name",
        "type": "string",
        "description": "Final internal NAD name.",
        "used_by": ["modules/eks-cluster-cneinstall"],
        "sensitive": false
      }
    ]
  },
  "providers": {
    "required": ["local", "null"],
    "optional": []
  },
  "deployment": {
    "order": 25,
    "estimated_time": "3 minutes",
    "requires_user_input": false,
    "sensitive_inputs": []
  }
}
