{
  "module": {
    "name": "EKS Cluster Install TMM NADs",
    "path": "modules/eks-cluster-install-tmm-nads",
    "version": "0.1.0-alpha",
    "layer": "application",
    "category": "bnk",
    "description": "Install Multus CNI + two NetworkAttachmentDefinitions (ens7-ipvlan-l2 external, ens8-ipvlan-l2 internal) so TMM's data-plane secondary interfaces work on AWS EKS. Replaces the manual NAD-apply step the -with-hp-nodes blueprints previously required as a prerequisite.",
    "cloud_specific": true,
    "supported_platforms": ["aws_eks"]
  },
  "source": {
    "kind": "official",
    "channel": "release/2.2"
  },
  "execution": {
    "engine": "opentofu",
    "deploy_models": ["kubernetes_manifest"]
  },
  "contract": {
    "metadata_version": "module-metadata/v2alpha1"
  },
  "dependencies": {
    "required": [],
    "optional": [
      {
        "module": "modules/eks-cluster-hp-nodes",
        "reason": "Logical predecessor — the NADs bind to the ens7/ens8 ENIs hp-nodes attaches. Order via depends_on in the blueprint."
      }
    ]
  },
  "inputs": {
    "required": [],
    "optional": [
      {
        "name": "install_multus",
        "type": "boolean",
        "description": "Apply the multus-daemonset. Set false if Multus already exists on the cluster.",
        "default": true,
        "source": "user"
      },
      {
        "name": "multus_version",
        "type": "string",
        "description": "Multus release tag.",
        "default": "v4.1.0",
        "source": "user"
      },
      {
        "name": "nad_namespace",
        "type": "string",
        "description": "Namespace for the NADs.",
        "default": "default",
        "source": "user"
      },
      {
        "name": "nad_external_name",
        "type": "string",
        "description": "External NAD name.",
        "default": "ens7-ipvlan-l2",
        "source": "user"
      },
      {
        "name": "nad_internal_name",
        "type": "string",
        "description": "Internal NAD name.",
        "default": "ens8-ipvlan-l2",
        "source": "user"
      }
    ]
  },
  "outputs": {
    "key_outputs": [
      {
        "name": "nads_applied",
        "type": "boolean",
        "description": "Gate output: both NADs applied.",
        "used_by": ["modules/eks-cluster-cneinstall"],
        "sensitive": false
      },
      {
        "name": "nad_external_name",
        "type": "string",
        "description": "Final external NAD name (echoed back).",
        "used_by": ["modules/eks-cluster-cneinstall"],
        "sensitive": false
      },
      {
        "name": "nad_internal_name",
        "type": "string",
        "description": "Final internal NAD name.",
        "used_by": ["modules/eks-cluster-cneinstall"],
        "sensitive": false
      }
    ]
  },
  "providers": {
    "required": ["local", "null"],
    "optional": []
  },
  "deployment": {
    "order": 25,
    "estimated_time": "3 minutes",
    "requires_user_input": false,
    "sensitive_inputs": []
  }
}
