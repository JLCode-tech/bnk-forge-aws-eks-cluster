{
  "module": {
    "name": "EKS Cluster TMM Cold-Start Heals",
    "path": "modules/eks-cluster-tmm-heal",
    "version": "1.0.0-alpha",
    "layer": "application",
    "category": "bnk",
    "description": "Best-effort BNK 2.3 cold-start heals (awsbnkctl phase24/24b/24c): cwc DNS-warmup force-bounce, dssm --insecure TLS overlay, f5-tmm-pod-manager rollout-restart. Runs after cneinstall, before the readiness gate. Never a gate (always exits 0).",
    "cloud_specific": true,
    "supported_platforms": ["aws_eks"]
  },
  "source": {
    "kind": "official",
    "channel": "release/2.3"
  },
  "execution": {
    "engine": "opentofu",
    "deploy_models": ["kubernetes_manifest"]
  },
  "contract": {
    "metadata_version": "module-metadata/v2alpha1"
  },
  "dependencies": {
    "required": [
      {
        "module": "modules/eks-cluster-cneinstall",
        "reason": "Heals target the CNEInstance-deployed runtime; run after the CNEInstance is applied."
      }
    ],
    "optional": []
  },
  "inputs": {
    "required": [],
    "optional": [
      {
        "name": "eks_cluster_name",
        "type": "string",
        "description": "EKS cluster name (kubeconfig refresh).",
        "source": "user"
      },
      {
        "name": "operator_namespace",
        "type": "string",
        "description": "Operator namespace (cwc).",
        "default": "f5-cne-core",
        "source": "module",
        "from_module": "modules/eks-cluster-install-bnk-prereqs",
        "from_output": "operator_namespace"
      },
      {
        "name": "instance_namespace",
        "type": "string",
        "description": "Instance namespace (dssm + controller).",
        "default": "f5-cne-system",
        "source": "module",
        "from_module": "modules/eks-cluster-install-bnk-prereqs",
        "from_output": "instance_namespace"
      },
      {
        "name": "cneinstall_ready",
        "type": "boolean",
        "description": "Ordering gate from cneinstall.",
        "default": true,
        "source": "module",
        "from_module": "modules/eks-cluster-cneinstall",
        "from_output": "host_device_applied"
      }
    ]
  },
  "outputs": {
    "key_outputs": [
      {
        "name": "heal_applied",
        "type": "boolean",
        "description": "Gate output: the heals have run.",
        "used_by": ["modules/eks-cluster-cneinstance-ready-gate"],
        "sensitive": false
      }
    ]
  },
  "providers": {
    "required": ["null"],
    "optional": []
  },
  "deployment": {
    "order": 95,
    "estimated_time": "5 minutes",
    "requires_user_input": false,
    "sensitive_inputs": []
  }
}
