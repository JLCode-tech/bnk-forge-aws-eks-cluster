{
  "schema_version": 1,
  "module": {
    "name": "aws_eks_cluster_tmm_heal",
    "path": "modules/eks-cluster-tmm-heal",
    "version": "1.0.0-alpha",
    "category": "bnk",
    "description": "Best-effort BNK 2.3 cold-start heals (awsbnkctl phase24/24b/24c): cwc DNS-warmup force-bounce, dssm --insecure TLS overlay + pod bounce, and f5-tmm-pod-manager rollout-restart on kube-proxy race. Runs after cneinstall and before the readiness gate. Never a gate — always exits 0.",
    "provider": "aws",
    "supported_platforms": ["aws_eks"],
    "tags": ["aws", "eks", "bnk", "tmm", "heal", "cold-start", "reliability"],
    "maturity": "alpha"
  },
  "deployment_pack": {
    "engine": "opentofu",
    "runner_profile": "opentofu-default",
    "working_directory": ".",
    "entrypoints": {
      "module_root": "."
    },
    "lifecycle": {
      "supports_init": true,
      "supports_plan": true,
      "supports_apply": true,
      "supports_destroy": true,
      "supports_refresh": true,
      "supports_drift": true
    }
  },
  "dependencies": {
    "required": [
      {
        "module": "modules/eks-cluster-cneinstall",
        "reason": "Heals target the CNEInstance-deployed runtime (cwc / dssm / f5-cne-controller); run after the CNEInstance + IRSA are applied."
      },
      {
        "module": "modules/eks-cluster-install-bnk-prereqs",
        "reason": "Provides operator_namespace (f5-cne-core) + instance_namespace (f5-cne-system)."
      }
    ],
    "optional": []
  },
  "inputs": {
    "required": [
      {
        "name": "aws_access_key_id",
        "type": "string",
        "description": "AWS access key ID. Resolved by Forge's credential template.",
        "source": "user",
        "sensitive": true
      },
      {
        "name": "aws_secret_access_key",
        "type": "string",
        "description": "AWS secret access key.",
        "source": "user",
        "sensitive": true
      },
      {
        "name": "aws_region",
        "type": "string",
        "description": "AWS region.",
        "source": "user"
      },
      {
        "name": "eks_cluster_name",
        "type": "string",
        "description": "EKS cluster name — used to refresh an exec-auth kubeconfig. Auto-wired from the blueprint eks_cluster_name input.",
        "source": "user"
      }
    ],
    "optional": [
      {
        "name": "aws_session_token",
        "type": "string",
        "description": "AWS session token (STS / SSO / assumed-role).",
        "source": "user",
        "sensitive": true,
        "default": ""
      },
      {
        "name": "operator_namespace",
        "type": "string",
        "description": "Operator namespace (cwc). Gold-standard split: f5-cne-core.",
        "source": "module",
        "from_module": "modules/eks-cluster-install-bnk-prereqs",
        "from_output": "operator_namespace",
        "default": "f5-cne-core"
      },
      {
        "name": "instance_namespace",
        "type": "string",
        "description": "Instance namespace (dssm + f5-cne-controller). Gold-standard split: f5-cne-system.",
        "source": "module",
        "from_module": "modules/eks-cluster-install-bnk-prereqs",
        "from_output": "instance_namespace",
        "default": "f5-cne-system"
      },
      {
        "name": "cneinstall_ready",
        "type": "boolean",
        "description": "Ordering gate from cneinstall.host_device_applied — heals run after the CNEInstance is applied.",
        "source": "module",
        "from_module": "modules/eks-cluster-cneinstall",
        "from_output": "host_device_applied",
        "default": true
      }
    ]
  },
  "outputs": {
    "key_outputs": [
      {
        "name": "heal_applied",
        "type": "boolean",
        "description": "Gate output — the best-effort heals have run. The readiness gate depends on this."
      }
    ]
  },
  "credentials": {
    "required": [
      {
        "name": "aws_access_key_id",
        "type": "cloud",
        "description": "AWS credential template (any auth method)."
      },
      {
        "name": "aws_secret_access_key",
        "type": "cloud",
        "description": "AWS credential template (any auth method)."
      }
    ],
    "optional": [
      {
        "name": "aws_session_token",
        "type": "cloud",
        "description": "AWS credential template (STS / SSO / assumed-role only)."
      }
    ]
  }
}
