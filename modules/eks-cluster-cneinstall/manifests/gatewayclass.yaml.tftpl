# GatewayClass — Gateway API entry point for the BNK cne-controller
# (awsbnkctl phase23b). Operator-facing Gateway CRs reference this class via
# .spec.gatewayClassName; the controller watches Gateways pointing at this
# controllerName and programs TMM listeners / pools. controllerName is
# namespace-scoped: f5.com/<instance_namespace>-f5-cne-controller.
apiVersion: gateway.networking.k8s.io/v1
kind: GatewayClass
metadata:
  name: ${gatewayclass_name}
  labels:
    app.kubernetes.io/managed-by: bnk-forge
    app.kubernetes.io/instance: ${eks_cluster_name}
spec:
  controllerName: f5.com/${instance_namespace}-f5-cne-controller
  description: F5 BIG-IP Kubernetes Gateway
