{
  "schema_version": 1,
  "blueprint": {
    "id": "aws-eks-cluster-create",
    "version": "0.4.0",
    "name": "Create EKS + BNK 2.3",
    "description": "Provision a new AWS EKS cluster (VPC + 3 AZs + managed node group) and install the BNK 2.3 platform on it."
  },
  "bnk_version": "2.3",
  "category": "infra",
  "cloud_provider": "aws",
  "compatibility": {
    "supported_platform_profiles": [
      "aws_eks"
    ],
    "required_capabilities": []
  },
  "icon": "Cloud",
  "color": "orange",
  "estimated_time": "25-40 minutes",
  "estimated_cost": "AWS usage-based (EKS + nodes + NAT)",
  "difficulty": "intermediate",
  "maturity": "beta",
  "tags": [
    "aws",
    "eks",
    "kubernetes",
    "bnk",
    "cluster-create"
  ],
  "prerequisites": [
    {
      "type": "credential_template",
      "name": "aws_credentials",
      "description": "AWS credential template (any of Forge's three auth methods). Principal needs VPC + EKS + IAM create privileges."
    },
    {
      "type": "project_secret",
      "name": "cne_pull_secret",
      "description": "F5 FAR registry credentials."
    },
    {
      "type": "project_secret",
      "name": "jwt_token",
      "description": "F5 BNK License JWT."
    }
  ],
  "inputs": {
    "required": [
      {
        "name": "aws_access_key_id",
        "type": "string",
        "description": "Auto-filled from the AWS credential template.",
        "sensitive": true,
        "source": "credential_template",
        "source_field": "aws_access_key_id",
        "order": 10
      },
      {
        "name": "aws_secret_access_key",
        "type": "string",
        "description": "Auto-filled from the AWS credential template.",
        "sensitive": true,
        "source": "credential_template",
        "source_field": "aws_secret_access_key",
        "order": 11
      },
      {
        "name": "aws_region",
        "type": "string",
        "description": "AWS region to deploy into.",
        "source": "project",
        "source_field": "region",
        "order": 12
      },
      {
        "name": "eks_cluster_name",
        "type": "string",
        "description": "Name for the new EKS cluster.",
        "order": 20
      },
      {
        "name": "jwt_token",
        "type": "string",
        "description": "F5 BNK License JWT. Bind to the jwt_token project secret.",
        "sensitive": true,
        "source": "project_secret",
        "source_field": "jwt_token",
        "order": 21
      }
    ],
    "optional": [
      {
        "name": "aws_session_token",
        "type": "string",
        "description": "Auto-filled from the AWS credential template (STS/SSO only).",
        "default": "",
        "sensitive": true,
        "source": "credential_template",
        "source_field": "aws_session_token",
        "order": 13
      },
      {
        "name": "worker_instance_type",
        "type": "string",
        "description": "EC2 instance type for the default node group.",
        "default": "m5.large",
        "order": 30
      },
      {
        "name": "worker_count_per_az",
        "type": "number",
        "description": "Worker nodes per AZ.",
        "default": 1,
        "order": 31
      },
      {
        "name": "vip_cidr",
        "type": "string",
        "description": "CIDR for BNK Gateway VIP allocation. Empty = auto-discover from tmm-external-tagged subnets.",
        "default": "",
        "order": 40
      },
      {
        "name": "tmm_replicas",
        "type": "number",
        "description": "TMM replicas. 0 = auto-derive from AZ × node count.",
        "default": 0,
        "order": 41
      },
      {
        "name": "deployment_size",
        "type": "string",
        "description": "CNEInstance size: Small / Medium / Large / Max.",
        "default": "Small",
        "order": 42
      }
    ]
  },
  "modules": [
    {
      "id": "cluster-create",
      "name": "EKS Cluster Create",
      "module": "modules/eks-cluster-create",
      "version": "0.1.0-beta",
      "depends_on": [],
      "inputs": {
        "aws_access_key_id": "${aws_access_key_id}",
        "aws_secret_access_key": "${aws_secret_access_key}",
        "aws_session_token": "${aws_session_token}",
        "aws_region": "${aws_region}",
        "eks_cluster_name": "${eks_cluster_name}",
        "worker_instance_type": "${worker_instance_type}",
        "worker_count_per_az": "${worker_count_per_az}"
      }
    },
    {
      "id": "bnk-prereqs",
      "name": "BNK Prerequisites",
      "module": "modules/eks-cluster-install-bnk-prereqs",
      "version": "1.0.0",
      "depends_on": [
        "cluster-create"
      ],
      "inputs": {
        "cluster_name": "${eks_cluster_name}"
      }
    },
    {
      "id": "cert-manager",
      "name": "Cert-Manager",
      "module": "modules/eks-cluster-install-cert-manager",
      "version": "3.1.0",
      "depends_on": [
        "bnk-prereqs"
      ],
      "inputs": {
        "cluster_name": "${eks_cluster_name}"
      }
    },
    {
      "id": "cert-issuer",
      "name": "BNK Cert Issuer",
      "module": "modules/eks-cluster-install-cert-issuer",
      "version": "1.0.0",
      "depends_on": [
        "cert-manager"
      ],
      "inputs": {}
    },
    {
      "id": "flo",
      "name": "F5 Lifecycle Operator",
      "module": "modules/eks-cluster-install-flo",
      "version": "2.0.0",
      "depends_on": [
        "cert-issuer"
      ],
      "inputs": {
        "cluster_name": "${eks_cluster_name}"
      }
    },
    {
      "id": "cneinstall",
      "name": "CNEInstance + IRSA",
      "module": "modules/eks-cluster-cneinstall",
      "version": "1.1.0",
      "depends_on": [
        "flo"
      ],
      "inputs": {
        "aws_access_key_id": "${aws_access_key_id}",
        "aws_secret_access_key": "${aws_secret_access_key}",
        "aws_session_token": "${aws_session_token}",
        "aws_region": "${aws_region}",
        "eks_cluster_name": "${eks_cluster_name}",
        "deployment_size": "${deployment_size}",
        "tmm_replicas": "${tmm_replicas}",
        "vip_cidr": "${vip_cidr}",
        "jwt_token": "${jwt_token}"
      }
    }
  ]
}
