{
  "schema_version": 1,
  "blueprint": {
    "id": "aws-eks-existing-cluster",
    "version": "0.8.1",
    "name": "Existing EKS + BNK 2.3",
    "description": "Install the BNK 2.3 platform onto an existing AWS EKS cluster."
  },
  "bnk_version": "2.3",
  "category": "bnk",
  "cloud_provider": "aws",
  "compatibility": {
    "supported_platform_profiles": [
      "aws_eks"
    ],
    "required_capabilities": []
  },
  "icon": "Server",
  "color": "orange",
  "estimated_time": "20-30 minutes",
  "estimated_cost": "AWS usage-based",
  "difficulty": "intermediate",
  "maturity": "beta",
  "tags": [
    "aws",
    "eks",
    "kubernetes",
    "bnk",
    "register"
  ],
  "prerequisites": [
    {
      "type": "kubernetes_cluster",
      "description": "An existing AWS EKS cluster reachable from the project. Use the 'AWS EKS Cluster Create' blueprint to provision one."
    },
    {
      "type": "credential_template",
      "name": "aws_credentials",
      "description": "AWS credential template (any of Forge's three auth methods)."
    },
    {
      "type": "project_secret",
      "name": "cne_pull_secret",
      "description": "F5 FAR registry credentials (base64-encoded service-account JSON or dockerconfigjson)."
    },
    {
      "type": "project_secret",
      "name": "jwt_token",
      "description": "F5 BNK License JWT."
    }
  ],
  "inputs": {
    "required": [
      {
        "name": "aws_access_key_id",
        "type": "string",
        "description": "Auto-filled from the AWS credential template.",
        "sensitive": true,
        "source": "credential_template",
        "source_field": "aws_access_key_id",
        "order": 10
      },
      {
        "name": "aws_secret_access_key",
        "type": "string",
        "description": "Auto-filled from the AWS credential template.",
        "sensitive": true,
        "source": "credential_template",
        "source_field": "aws_secret_access_key",
        "order": 11
      },
      {
        "name": "aws_region",
        "type": "string",
        "description": "AWS region where the cluster resides.",
        "source": "project",
        "source_field": "region",
        "order": 12
      },
      {
        "name": "eks_cluster_name",
        "type": "string",
        "description": "Name of the existing EKS cluster.",
        "order": 20
      },
      {
        "name": "jwt_token",
        "type": "string",
        "description": "F5 BNK License JWT. Bind to the jwt_token project secret.",
        "sensitive": true,
        "source": "project_secret",
        "source_field": "jwt_token",
        "order": 21
      }
    ],
    "optional": [
      {
        "name": "aws_session_token",
        "type": "string",
        "description": "Auto-filled from the AWS credential template (STS/SSO only).",
        "default": "",
        "sensitive": true,
        "source": "credential_template",
        "source_field": "aws_session_token",
        "order": 13
      },
      {
        "name": "vip_cidr",
        "type": "string",
        "description": "CIDR for BNK Gateway VIP allocation. Empty = auto-discover from tmm-external-tagged subnets.",
        "default": "",
        "order": 30
      },
      {
        "name": "tmm_replicas",
        "type": "number",
        "description": "TMM replicas. 0 = auto-derive from cluster AZ × node count.",
        "default": 0,
        "order": 31
      },
      {
        "name": "deployment_size",
        "type": "string",
        "description": "CNEInstance size: Small / Medium / Large / Max.",
        "default": "Small",
        "order": 32
      }
    ]
  },
  "modules": [
    {
      "id": "cluster-register",
      "name": "EKS Cluster Register",
      "module": "modules/eks-cluster-register",
      "version": "1.1.0",
      "depends_on": [],
      "inputs": {
        "aws_access_key_id": "${aws_access_key_id}",
        "aws_secret_access_key": "${aws_secret_access_key}",
        "aws_session_token": "${aws_session_token}",
        "aws_region": "${aws_region}",
        "eks_cluster_name": "${eks_cluster_name}"
      }
    },
    {
      "id": "bnk-prereqs",
      "name": "BNK Prerequisites",
      "module": "modules/eks-cluster-install-bnk-prereqs",
      "version": "1.0.0",
      "depends_on": [
        "cluster-register"
      ],
      "inputs": {
        "cluster_name": "${eks_cluster_name}"
      }
    },
    {
      "id": "cert-manager",
      "name": "Cert-Manager",
      "module": "modules/eks-cluster-install-cert-manager",
      "version": "3.1.0",
      "depends_on": [
        "bnk-prereqs"
      ],
      "inputs": {
        "cluster_name": "${eks_cluster_name}"
      }
    },
    {
      "id": "cert-issuer",
      "name": "BNK Cert Issuer",
      "module": "modules/eks-cluster-install-cert-issuer",
      "version": "1.0.0",
      "depends_on": [
        "cert-manager"
      ],
      "inputs": {}
    },
    {
      "id": "flo",
      "name": "F5 Lifecycle Operator",
      "module": "modules/eks-cluster-install-flo",
      "version": "2.0.0",
      "depends_on": [
        "cert-issuer"
      ],
      "inputs": {
        "cluster_name": "${eks_cluster_name}"
      }
    },
    {
      "id": "cneinstall",
      "name": "CNEInstance + IRSA",
      "module": "modules/eks-cluster-cneinstall",
      "version": "1.1.0",
      "depends_on": [
        "flo"
      ],
      "inputs": {
        "aws_access_key_id": "${aws_access_key_id}",
        "aws_secret_access_key": "${aws_secret_access_key}",
        "aws_session_token": "${aws_session_token}",
        "aws_region": "${aws_region}",
        "deployment_size": "${deployment_size}",
        "tmm_replicas": "${tmm_replicas}",
        "vip_cidr": "${vip_cidr}",
        "jwt_token": "${jwt_token}"
      }
    }
  ]
}
