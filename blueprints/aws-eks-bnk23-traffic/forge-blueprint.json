{
  "schema_version": 1,
  "blueprint": {
    "id": "aws-eks-bnk23-traffic",
    "version": "0.5.1",
    "name": "AWS EKS + BNK 2.3 Traffic-Ready",
    "description": "One-field deploy: provisions a new AWS EKS cluster and installs the full BNK 2.3 platform (HP TMM node pool, Multus, hugepages, cert-manager, FLO, CNEInstance, license gate). Only the cluster name is required; all credentials and operational settings are resolved automatically."
  },
  "bnk_version": "2.3",
  "category": "infra",
  "cloud_provider": "aws",
  "compatibility": {
    "supported_platform_profiles": [
      "aws_eks"
    ],
    "required_capabilities": []
  },
  "icon": "Cloud",
  "color": "orange",
  "estimated_time": "40-60 minutes",
  "estimated_cost": "AWS usage-based (EKS control plane + 3× m6i.4xlarge workers + 1× c5n.4xlarge HP node + NAT gateway)",
  "difficulty": "intermediate",
  "maturity": "alpha",
  "tags": [
    "aws",
    "eks",
    "kubernetes",
    "bnk",
    "bnk-2.3",
    "cluster-create",
    "hp-nodes",
    "tmm",
    "traffic-ready",
    "opinionated"
  ],
  "prerequisites": [
    {
      "type": "credential_template",
      "name": "aws_credentials",
      "description": "AWS credentials with VPC, EKS, and IAM create privileges."
    },
    {
      "type": "project_secret",
      "name": "cne_pull_secret",
      "description": "F5 FAR registry pull secret."
    },
    {
      "type": "project_secret",
      "name": "jwt_token",
      "description": "F5 BNK license JWT."
    }
  ],
  "inputs": {
    "required": [
      {
        "name": "eks_cluster_name",
        "type": "string",
        "description": "EKS cluster name",
        "order": 20
      }
    ],
    "optional": [
      {
        "name": "aws_access_key_id",
        "type": "string",
        "description": "AWS access key ID (auto-filled from credential template).",
        "sensitive": true,
        "source": "credential_template",
        "source_field": "aws_access_key_id",
        "order": 10
      },
      {
        "name": "aws_secret_access_key",
        "type": "string",
        "description": "AWS secret access key (auto-filled from credential template).",
        "sensitive": true,
        "source": "credential_template",
        "source_field": "aws_secret_access_key",
        "order": 11
      },
      {
        "name": "aws_region",
        "type": "string",
        "description": "AWS region (auto-filled from project).",
        "source": "project",
        "source_field": "region",
        "order": 12
      },
      {
        "name": "aws_session_token",
        "type": "string",
        "description": "AWS session token (auto-filled from credential template; empty for static keys).",
        "default": "",
        "sensitive": true,
        "source": "credential_template",
        "source_field": "aws_session_token",
        "order": 13
      },
      {
        "name": "jwt_token",
        "type": "string",
        "description": "F5 BNK license JWT (resolved from project secret).",
        "sensitive": true,
        "source": "project_secret",
        "order": 21
      },
      {
        "name": "cne_pull_secret",
        "type": "string",
        "description": "F5 FAR registry pull credentials (resolved from project secret).",
        "sensitive": true,
        "source": "project_secret",
        "order": 22
      },
      {
        "name": "worker_instance_type",
        "type": "string",
        "description": "Worker node instance type.",
        "default": "m6i.4xlarge",
        "source": "module",
        "order": 30
      },
      {
        "name": "worker_count_per_az",
        "type": "number",
        "description": "Worker nodes per AZ.",
        "default": 1,
        "source": "module",
        "order": 31
      },
      {
        "name": "hp_instance_type",
        "type": "string",
        "description": "HP TMM node instance type.",
        "default": "c5n.4xlarge",
        "source": "module",
        "order": 32
      },
      {
        "name": "hp_node_count_per_az",
        "type": "number",
        "description": "HP TMM nodes per AZ.",
        "default": 1,
        "source": "module",
        "order": 33
      },
      {
        "name": "deployment_size",
        "type": "string",
        "description": "CNEInstance deployment size (Small / Medium / Large / Max).",
        "default": "Small",
        "source": "module",
        "order": 40
      },
      {
        "name": "tmm_replicas",
        "type": "number",
        "description": "TMM replicas.",
        "default": 1,
        "source": "module",
        "order": 41
      },
      {
        "name": "vip_cidr",
        "type": "string",
        "description": "VIP CIDR for BNK Gateway (empty = auto-discover from HP-node TMM subnets).",
        "default": "",
        "source": "module",
        "order": 42
      },
      {
        "name": "instance_namespace",
        "type": "string",
        "description": "CNEInstance namespace.",
        "default": "f5-cne-system",
        "source": "module",
        "order": 50
      },
      {
        "name": "instance_name",
        "type": "string",
        "description": "CNEInstance CR name.",
        "default": "default-f5-cne-controller",
        "source": "module",
        "order": 51
      },
      {
        "name": "license_namespace",
        "type": "string",
        "description": "Namespace for the BNK License CR (must match FLO/operator namespace).",
        "default": "f5-cne-core",
        "source": "module",
        "order": 52
      }
    ]
  },
  "modules": [
    {
      "id": "cluster-create",
      "name": "EKS Cluster Create",
      "module": "modules/eks-cluster-create",
      "version": "0.1.0-beta",
      "depends_on": [],
      "inputs": {
        "aws_access_key_id": "${aws_access_key_id}",
        "aws_secret_access_key": "${aws_secret_access_key}",
        "aws_session_token": "${aws_session_token}",
        "aws_region": "${aws_region}",
        "eks_cluster_name": "${eks_cluster_name}",
        "worker_instance_type": "${worker_instance_type}",
        "worker_count_per_az": "${worker_count_per_az}",
        "tag_private_subnets_for_tmm": false,
        "eks_cluster_version": "1.32"
      }
    },
    {
      "id": "hp-nodes",
      "name": "HP TMM Node Pool",
      "module": "modules/eks-cluster-hp-nodes",
      "version": "0.5.0-alpha",
      "depends_on": [
        "cluster-create"
      ],
      "inputs": {
        "aws_access_key_id": "${aws_access_key_id}",
        "aws_secret_access_key": "${aws_secret_access_key}",
        "aws_session_token": "${aws_session_token}",
        "aws_region": "${aws_region}",
        "instance_type": "${hp_instance_type}",
        "node_count_per_az": "${hp_node_count_per_az}"
      }
    },
    {
      "id": "install-multus",
      "name": "Install Multus CNI",
      "module": "modules/eks-cluster-install-multus",
      "version": "0.2.0-alpha",
      "depends_on": [
        "hp-nodes"
      ],
      "inputs": {}
    },
    {
      "id": "install-hugepages",
      "name": "Install Hugepages DaemonSet",
      "module": "modules/eks-cluster-install-hugepages",
      "version": "0.1.0-alpha",
      "depends_on": [
        "hp-nodes",
        "install-multus"
      ],
      "inputs": {}
    },
    {
      "id": "tmm-nads",
      "name": "TMM Host-Device Dataplane",
      "module": "modules/eks-cluster-install-tmm-nads",
      "version": "1.0.0-alpha",
      "depends_on": [
        "hp-nodes",
        "install-multus",
        "bnk-prereqs"
      ],
      "inputs": {
        "aws_access_key_id": "${aws_access_key_id}",
        "aws_secret_access_key": "${aws_secret_access_key}",
        "aws_session_token": "${aws_session_token}",
        "aws_region": "${aws_region}",
        "eks_cluster_name": "${eks_cluster_name}",
        "nad_namespace": "f5-cne-system"
      }
    },
    {
      "id": "bnk-prereqs",
      "name": "BNK Prerequisites",
      "module": "modules/eks-cluster-install-bnk-prereqs",
      "version": "1.0.0",
      "depends_on": [
        "cluster-create",
        "hp-nodes",
        "install-multus"
      ],
      "inputs": {
        "cluster_name": "${eks_cluster_name}",
        "cne_pull_secret": "${cne_pull_secret}",
        "operator_namespace": "f5-cne-core",
        "instance_namespace": "f5-cne-system"
      }
    },
    {
      "id": "cert-manager",
      "name": "Cert-Manager",
      "module": "modules/eks-cluster-install-cert-manager",
      "version": "3.1.0",
      "depends_on": [
        "bnk-prereqs"
      ],
      "inputs": {
        "cluster_name": "${eks_cluster_name}"
      }
    },
    {
      "id": "cert-issuer",
      "name": "BNK Cert Issuer",
      "module": "modules/eks-cluster-install-cert-issuer",
      "version": "1.0.0",
      "depends_on": [
        "cert-manager"
      ],
      "inputs": {}
    },
    {
      "id": "flo",
      "name": "F5 Lifecycle Operator",
      "module": "modules/eks-cluster-install-flo",
      "version": "2.0.0",
      "depends_on": [
        "cert-issuer"
      ],
      "inputs": {
        "cluster_name": "${eks_cluster_name}"
      }
    },
    {
      "id": "cneinstall",
      "name": "CNEInstance + IRSA + Host-Device",
      "module": "modules/eks-cluster-cneinstall",
      "version": "1.2.0",
      "depends_on": [
        "flo",
        "tmm-nads",
        "install-hugepages"
      ],
      "inputs": {
        "aws_access_key_id": "${aws_access_key_id}",
        "aws_secret_access_key": "${aws_secret_access_key}",
        "aws_session_token": "${aws_session_token}",
        "aws_region": "${aws_region}",
        "eks_cluster_name": "${eks_cluster_name}",
        "deployment_size": "${deployment_size}",
        "tmm_replicas": "${tmm_replicas}",
        "vip_cidr": "${vip_cidr}",
        "network_attachments": [
          "external-netdevice",
          "internal-netdevice"
        ],
        "jwt_token": "${jwt_token}"
      }
    },
    {
      "id": "tmm-heal",
      "name": "TMM Cold-Start Heals",
      "module": "modules/eks-cluster-tmm-heal",
      "version": "1.0.0-alpha",
      "depends_on": [
        "license-gate"
      ],
      "inputs": {
        "aws_access_key_id": "${aws_access_key_id}",
        "aws_secret_access_key": "${aws_secret_access_key}",
        "aws_session_token": "${aws_session_token}",
        "aws_region": "${aws_region}",
        "eks_cluster_name": "${eks_cluster_name}"
      }
    },
    {
      "id": "ready-gate",
      "name": "CNEInstance Readiness Gate",
      "module": "modules/eks-cluster-cneinstance-ready-gate",
      "version": "0.1.0-alpha",
      "depends_on": [
        "tmm-heal"
      ],
      "inputs": {
        "instance_namespace": "${instance_namespace}",
        "instance_name": "${instance_name}"
      }
    },
    {
      "id": "license-gate",
      "name": "BNK License Activation Gate",
      "module": "modules/eks-cluster-license-activation-gate",
      "version": "0.1.0-alpha",
      "depends_on": [
        "cneinstall"
      ],
      "inputs": {
        "jwt_token": "${jwt_token}",
        "license_namespace": "${license_namespace}"
      }
    }
  ]
}
