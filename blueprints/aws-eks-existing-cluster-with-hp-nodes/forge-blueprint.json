{
  "schema_version": 1,
  "blueprint": {
    "id": "aws-eks-existing-cluster-with-hp-nodes",
    "version": "0.4.0",
    "name": "Existing EKS + HP + BNK 2.3",
    "description": "Adopt an existing AWS EKS cluster, add a dedicated HP TMM node pool (dual secondary ENIs), and install the BNK 2.3 platform."
  },
  "bnk_version": "2.3",
  "category": "bnk",
  "cloud_provider": "aws",
  "compatibility": {
    "supported_platform_profiles": [
      "aws_eks"
    ],
    "required_capabilities": []
  },
  "icon": "Server",
  "color": "orange",
  "estimated_time": "25-40 minutes",
  "estimated_cost": "AWS usage-based (adds ~3× m5n.large)",
  "difficulty": "advanced",
  "maturity": "alpha",
  "tags": [
    "aws",
    "eks",
    "kubernetes",
    "bnk",
    "hp-nodes",
    "tmm"
  ],
  "prerequisites": [
    {
      "type": "kubernetes_cluster",
      "description": "An existing AWS EKS cluster reachable from the project."
    },
    {
      "type": "credential_template",
      "name": "aws_credentials",
      "description": "AWS credential template (any of Forge's three auth methods)."
    },
    {
      "type": "project_secret",
      "name": "cne_pull_secret",
      "description": "F5 FAR registry credentials."
    },
    {
      "type": "project_secret",
      "name": "jwt_token",
      "description": "F5 BNK License JWT."
    }
  ],
  "inputs": {
    "required": [
      {
        "name": "aws_access_key_id",
        "type": "string",
        "description": "Auto-filled from the AWS credential template.",
        "sensitive": true,
        "source": "credential_template",
        "source_field": "aws_access_key_id",
        "order": 10
      },
      {
        "name": "aws_secret_access_key",
        "type": "string",
        "description": "Auto-filled from the AWS credential template.",
        "sensitive": true,
        "source": "credential_template",
        "source_field": "aws_secret_access_key",
        "order": 11
      },
      {
        "name": "aws_region",
        "type": "string",
        "description": "AWS region.",
        "source": "project",
        "source_field": "region",
        "order": 12
      },
      {
        "name": "eks_cluster_name",
        "type": "string",
        "description": "Name of the existing EKS cluster.",
        "order": 20
      },
      {
        "name": "jwt_token",
        "type": "string",
        "description": "F5 BNK License JWT. Bind to the jwt_token project secret.",
        "sensitive": true,
        "source": "project_secret",
        "source_field": "jwt_token",
        "order": 21
      }
    ],
    "optional": [
      {
        "name": "aws_session_token",
        "type": "string",
        "description": "Auto-filled from the AWS credential template (STS/SSO only).",
        "default": "",
        "sensitive": true,
        "source": "credential_template",
        "source_field": "aws_session_token",
        "order": 13
      },
      {
        "name": "hp_instance_type",
        "type": "string",
        "description": "EC2 instance type for HP TMM nodes (must support 3 ENIs).",
        "default": "m5n.large",
        "order": 30
      },
      {
        "name": "hp_node_count_per_az",
        "type": "number",
        "description": "HP nodes per AZ.",
        "default": 1,
        "order": 31
      },
      {
        "name": "vip_cidr",
        "type": "string",
        "description": "CIDR for BNK Gateway VIP allocation. Empty = auto-discover from HP-nodes TMM-external subnets.",
        "default": "",
        "order": 40
      },
      {
        "name": "tmm_replicas",
        "type": "number",
        "description": "TMM replicas. 0 = auto-derive from AZ × HP node count.",
        "default": 0,
        "order": 41
      },
      {
        "name": "deployment_size",
        "type": "string",
        "description": "CNEInstance size: Small / Medium / Large / Max.",
        "default": "Small",
        "order": 42
      }
    ]
  },
  "modules": [
    {
      "id": "cluster-register",
      "name": "EKS Cluster Register",
      "module": "modules/eks-cluster-register",
      "version": "1.1.0",
      "depends_on": [],
      "inputs": {
        "aws_access_key_id": "${aws_access_key_id}",
        "aws_secret_access_key": "${aws_secret_access_key}",
        "aws_session_token": "${aws_session_token}",
        "aws_region": "${aws_region}",
        "eks_cluster_name": "${eks_cluster_name}"
      }
    },
    {
      "id": "hp-nodes",
      "name": "HP TMM Node Pool",
      "module": "modules/eks-cluster-hp-nodes",
      "version": "0.3.0-alpha",
      "depends_on": [
        "cluster-register"
      ],
      "inputs": {
        "aws_access_key_id": "${aws_access_key_id}",
        "aws_secret_access_key": "${aws_secret_access_key}",
        "aws_session_token": "${aws_session_token}",
        "aws_region": "${aws_region}",
        "instance_type": "${hp_instance_type}",
        "node_count_per_az": "${hp_node_count_per_az}"
      }
    },
    {
      "id": "install-multus",
      "name": "Install Multus CNI",
      "module": "modules/eks-cluster-install-multus",
      "version": "0.2.0-alpha",
      "depends_on": [
        "hp-nodes"
      ],
      "inputs": {}
    },
    {
      "id": "tmm-nads",
      "name": "TMM NADs (ens7/ens8)",
      "module": "modules/eks-cluster-install-tmm-nads",
      "version": "0.3.0-alpha",
      "depends_on": [
        "hp-nodes",
        "install-multus"
      ],
      "inputs": {
        "aws_access_key_id": "${aws_access_key_id}",
        "aws_secret_access_key": "${aws_secret_access_key}",
        "aws_session_token": "${aws_session_token}",
        "aws_region": "${aws_region}"
      }
    },
    {
      "id": "bnk-prereqs",
      "name": "BNK Prerequisites",
      "module": "modules/eks-cluster-install-bnk-prereqs",
      "version": "1.0.0",
      "depends_on": [
        "cluster-register",
        "hp-nodes",
        "install-multus",
        "tmm-nads"
      ],
      "inputs": {
        "cluster_name": "${eks_cluster_name}"
      }
    },
    {
      "id": "cert-manager",
      "name": "Cert-Manager",
      "module": "modules/eks-cluster-install-cert-manager",
      "version": "3.1.0",
      "depends_on": [
        "bnk-prereqs"
      ],
      "inputs": {
        "cluster_name": "${eks_cluster_name}"
      }
    },
    {
      "id": "cert-issuer",
      "name": "BNK Cert Issuer",
      "module": "modules/eks-cluster-install-cert-issuer",
      "version": "1.0.0",
      "depends_on": [
        "cert-manager"
      ],
      "inputs": {}
    },
    {
      "id": "flo",
      "name": "F5 Lifecycle Operator",
      "module": "modules/eks-cluster-install-flo",
      "version": "2.0.0",
      "depends_on": [
        "cert-issuer"
      ],
      "inputs": {
        "cluster_name": "${eks_cluster_name}"
      }
    },
    {
      "id": "cneinstall",
      "name": "CNEInstance + IRSA",
      "module": "modules/eks-cluster-cneinstall",
      "version": "1.1.0",
      "depends_on": [
        "flo",
        "tmm-nads"
      ],
      "inputs": {
        "aws_access_key_id": "${aws_access_key_id}",
        "aws_secret_access_key": "${aws_secret_access_key}",
        "aws_session_token": "${aws_session_token}",
        "aws_region": "${aws_region}",
        "deployment_size": "${deployment_size}",
        "tmm_replicas": "${tmm_replicas}",
        "vip_cidr": "${vip_cidr}",
        "network_attachments": [
          "ens7-ipvlan-l2",
          "ens8-ipvlan-l2"
        ],
        "jwt_token": "${jwt_token}"
      }
    }
  ]
}
